{
  "name": "@aarvay/pi-packs",
  "version": "0.0.0",
  "private": true,
  "description": "A monorepo of pi extensions",
  "homepage": "https://github.com/aarvay/pi-packs#readme",
  "bugs": {
    "url": "https://github.com/aarvay/pi-packs/issues"
  },
  "license": "MIT",
  "author": "aarvay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aarvay/pi-packs.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "changeset": "changeset",
    "ci:version": "changeset version && bun update",
    "ci:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "latest",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.77.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
